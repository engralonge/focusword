{
  "expo": {
    "name": "Citizens Bible Community",
    "slug": "focusword",
    "owner": "frankalonge",
    "scheme": "focusword",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/6d365de0-f73e-4198-a944-946f7da79dec"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.focusword.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Citizens Bible Community uses your camera when you host or join an interactive live Bible study.",
        "NSMicrophoneUsageDescription": "Citizens Bible Community uses your microphone when you host or join an interactive live Bible study."
      },
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050608",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.focusword.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-dev-client",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#D4B87A",
          "defaultChannel": "live-study-reminders"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Citizens Bible Community uses your selected photo as your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "6d365de0-f73e-4198-a944-946f7da79dec"
      }
    }
  }
}
