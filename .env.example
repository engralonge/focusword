EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_SUPPORT_URL=https://example.com/support

# Resend SMTP is configured only in Supabase Authentication settings.
# Never add a Resend API key or SMTP password to the Expo environment.
#
# Server-only secrets belong in Supabase, never in this Expo file:
# supabase secrets set XAI_API_KEY=... XAI_MODEL=grok-4.3
# supabase secrets set API_BIBLE_KEY=...
# supabase secrets set API_BIBLE_KJV_ID=... API_BIBLE_NIV_ID=... API_BIBLE_ESV_ID=...
# supabase secrets set LIVEKIT_URL=wss://... LIVEKIT_API_KEY=... LIVEKIT_API_SECRET=...
